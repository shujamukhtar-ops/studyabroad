# Copy to .env and fill in real values. Never commit the real .env.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgres://studyabroad:studyabroad@localhost:5433/studyabroad

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme
JWT_EXPIRES_IN=7d

# --- AI provider ---
# 'mock' for local dev/tests, 'bedrock' for real Claude calls via AWS Bedrock
AI_PROVIDER=mock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# --- Data ingestion: College Scorecard ---
# Free DEMO_KEY works for development; register a real key at api.data.gov before production.
COLLEGE_SCORECARD_API_KEY=DEMO_KEY
